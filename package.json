{
  "name": "ab-ignite-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "api:dev": "node --import dotenv/config --conditions=react-server --import tsx --watch apps/api/src/server.ts",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node --import dotenv/config --conditions=react-server --import tsx apps/api/src/server.ts",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "api:test": "node --conditions=react-server --import tsx --test apps/api/test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "test:client": "tsx --test src/lib/api/*.test.ts src/lib/query/*.test.ts src/store/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test:ai": "tsx --test --test-concurrency=1 test/*.test.ts",
    "ai:worker": "tsx scripts/run-ai-worker.ts",
    "notifications:worker": "tsx scripts/run-notification-email-worker.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@headlessui/react": "^2.2.9",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.5",
    "argon2": "^0.45.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
